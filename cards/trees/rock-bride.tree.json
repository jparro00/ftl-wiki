{
  "schema": "ftl-event-tree/1",
  "id": "ROCK_QUEST_MARRIAGE_START",
  "slug": "rock-bride",
  "title": "Rock bride",
  "extracted_from": "raw/gamedata/events_rock.xml",
  "text": {
    "value": "A Rock captain hails you: \"It is improper of me to contact off-worlders, but this is an emergency. We were on our way to deliver our passenger to her new husband - the Grand Basilisk of Numa V - when our engines broke down. Will you take possession of her and make haste to Numa V?\"",
    "ref": "event_ROCK_QUEST_MARRIAGE_START_text"
  },
  "name": "ROCK_QUEST_MARRIAGE_START",
  "source": "raw/gamedata/events_rock.xml",
  "effects": [],
  "flags": {
    "unique": true
  },
  "node": {
    "kind": "decision",
    "options": [
      {
        "label": "Accept the passenger.",
        "gate": null,
        "child": {
          "text": {
            "value": "\"You surprise me, off-worlder. Thank you. The passenger will be with you momentarily.\" She refuses to enter the main hold and prefers to wait in the cargo bay.",
            "ref": "event_ROCK_QUEST_MARRIAGE_START_c1_text"
          },
          "effects": [
            {
              "kind": "quest",
              "event": "ROCK_QUEST_MARRIAGE"
            }
          ]
        },
        "label_ref": "event_ROCK_QUEST_MARRIAGE_START_c1_choice",
        "hidden": true
      },
      {
        "label": "Refuse.",
        "gate": null,
        "child": {
          "text": {
            "value": "Arranged marriages aren't on your list of worthy causes. You leave the Rock to their business.",
            "ref": "event_ROCK_QUEST_MARRIAGE_START_c2_text"
          },
          "effects": []
        },
        "label_ref": "event_ROCK_QUEST_MARRIAGE_START_c2_choice",
        "hidden": true
      }
    ]
  },
  "chain": [
    {
      "id": "ROCK_QUEST_MARRIAGE",
      "from": "ROCK_QUEST_MARRIAGE_START",
      "slug": "rock-quest-marriage",
      "title": "Numa V",
      "text": {
        "value": "A vast tunnel network near the surface of Numa V indicates an advanced Rock civilization. This must be where you were asked to deliver the passenger.",
        "ref": "event_ROCK_QUEST_MARRIAGE_text"
      },
      "name": "ROCK_QUEST_MARRIAGE",
      "source": "raw/gamedata/events_rock.xml",
      "effects": [],
      "node": {
        "kind": "decision",
        "options": [
          {
            "label": "Continue...",
            "gate": null,
            "child": {
              "text": {
                "value": "Realizing arrival is imminent, the passenger - silent so far - pleads with you not to hand her over. She's interrupted by the Grand Basilisk's Chief Aid: \"To the alien vessel holding the Basilisk's wife. Deliver her to us. You will be rewarded... well.\"",
                "ref": "event_ROCK_QUEST_MARRIAGE_c1_text"
              },
              "effects": [],
              "node": {
                "kind": "decision",
                "options": [
                  {
                    "label": "Hand her over.",
                    "gate": null,
                    "child": {
                      "text": {
                        "value": "\"May your children erode into dust!\" she screams as she's bundled into the waiting shuttle. The Rock guards on board hurriedly drop off an exotic piece of technology and return to the Grand Basilisk.",
                        "ref": "event_ROCK_QUEST_MARRIAGE_c1_c1_text"
                      },
                      "effects": [
                        {
                          "kind": "item",
                          "item_kind": "augment",
                          "id": "RANDOM",
                          "label": "RANDOM"
                        },
                        {
                          "kind": "reward",
                          "level": "LOW",
                          "tier": "scrap_only"
                        }
                      ]
                    },
                    "label_ref": "event_ROCK_QUEST_MARRIAGE_c1_c1_choice",
                    "hidden": true
                  },
                  {
                    "label": "Refuse to comply.",
                    "gate": null,
                    "child": {
                      "text": {
                        "value": "\"I was led to believe your kind did not know mercy. I will join you. But quickly, we must jump away - they will not tolerate...\" She's interrupted by weapons fire from the Basilisk's escort!",
                        "ref": "event_ROCK_QUEST_MARRIAGE_c1_c2_text"
                      },
                      "effects": [
                        {
                          "kind": "crew_gain",
                          "amount": 1,
                          "class": "rock",
                          "name": "Ariadne"
                        }
                      ],
                      "node": {
                        "kind": "combat",
                        "ship": "ROCK_QUEST_MARRIAGE",
                        "ship_labels": [
                          "Rock Scout",
                          "Rock Fighter",
                          "Rock Assault"
                        ],
                        "hostile": true,
                        "auto_blueprint": "SHIPS_ROCK",
                        "source": "raw/gamedata/events_rock.xml",
                        "branches": [
                          {
                            "on": "destroyed",
                            "child": {
                              "text": {
                                "value": "His escort eliminated, the Grand Basilisk dispatches his entire fleet. There's just time to take your pick from the wreck before you jump out of their reach.",
                                "ref": "ship_ROCK_QUEST_MARRIAGE_destroyed_text"
                              },
                              "effects": [
                                {

{
  "schema": "ftl-event-tree/1",
  "id": "ROCK_UNLOCK1",
  "slug": "rock-unlock1",
  "title": "Rock cruiser unlock, step 1",
  "extracted_from": "raw/gamedata/events_rock.xml",
  "text": {
    "value": "You are immediately messaged by an imposing looking Rock war vessel, \"You're the ship off to 'save the Federation,' aren't you? And you expect to survive with that hunk of junk?\"",
    "ref": "event_ROCK_UNLOCK1_text"
  },
  "name": "ROCK_UNLOCK1",
  "source": "raw/gamedata/events_rock.xml",
  "effects": [],
  "flags": {
    "unique": true
  },
  "node": {
    "kind": "decision",
    "options": [
      {
        "label": "\"We're going to save them or die trying.\"",
        "gate": null,
        "child": {
          "text": {
            "value": "\"The latter being more likely. Still... we can potentially help you and your precious fleet, but you'll need to prove yourself first. Meet us at these coordinates.\" They jump away.",
            "ref": "event_ROCK_UNLOCK1_c1_text"
          },
          "effects": [
            {
              "kind": "quest",
              "event": "ROCK_UNLOCK2"
            }
          ]
        },
        "label_ref": "event_ROCK_UNLOCK1_c1_choice",
        "hidden": true
      },
      {
        "label": "\"We're strong enough to destroy you!\"",
        "gate": null,
        "child": {
          "text": {
            "value": "\"One ship is not the same as a fleet, but at least you've got some fire. Meet us at these coordinates if you want to prove to us that the Federation is worth saving.\" They jump away.",
            "ref": "event_ROCK_UNLOCK1_c2_text"
          },
          "effects": [
            {
              "kind": "quest",
              "event": "ROCK_UNLOCK2"
            }
          ]
        },
        "label_ref": "event_ROCK_UNLOCK1_c2_choice",
        "hidden": true
      },
      {
        "label": "Ignore them.",
        "gate": null,
        "child": {
          "text": {
            "value": "\"Heh. Like I expected. If the Federation is as weak as you it deserves to fall.\" They jump away without another word.",
            "ref": "event_ROCK_UNLOCK1_c3_text"
          },
          "effects": []
        },
        "label_ref": "event_ROCK_UNLOCK1_c3_choice",
        "hidden": true
      }
    ],
    "combat": {
      "kind": "combat",
      "ship": "ROCK_UNLOCK2",
      "ship_label": "Rock Assault",
      "hostile": false,
      "auto_blueprint": "ROCK_ASSAULT_ELITE",
      "source": "raw/gamedata/events_ships.xml",
      "branches": [
        {
          "on": "destroyed",
          "child": {
            "text": {
              "value": "Their ship breaks apart and you feel a twinge of guilt. Perhaps they could have helped the Federation if this had gone another way. You scrap what you can and prepare to jump out of the heat.",
              "ref": "ship_ROCK_UNLOCK2_destroyed_text"
            },
            "effects": [
              {
                "kind": "reward",
                "level": "MED",
                "tier": "standard"
              }
            ]
          }
        },
        {
          "on": "deadCrew",
          "child": {
            "text": {
              "value": "Their ship goes quiet and you feel a twinge of guilt. Perhaps they could have helped the Federation if this had gone another way. You scrap what you can and prepare to jump out of the heat.",
              "ref": "ship_ROCK_UNLOCK2_deadCrew_text"
            },
            "effects": [
              {
                "kind": "reward",
                "level": "HIGH",
                "tier": "standard"
              }
            ]
          }
        },
        {
          "on": "escape",
          "child": {
            "text": {
              "value": "The Rock ship starts to power up their FTL drive. If we're going to earn their trust we must endure the heat for as long as they can!",
              "ref": "ship_ROCK_UNLOCK2_escape_text"
            },
            "effects": [
              {
                "kind": "ship_hostility",
                "hostile": true
              }
            ]
          },
          "min": "28",
          "max": "28"
        },
        {
          "on": "gotaway",
          "child": {
            "text": {
              "value": "As they jump away they relay coordinates to your navigation system. They must mean for you to follow them!",
              "ref": "ship_ROCK_UNLOCK2_gotaway_text"
            },
            "effects": [
              {
                "kind": "quest",
                "event": "ROCK_UNLOCK3"
              }
            ]
          }
        }
      ],
      "reachable": false,
      "unreachable_because": "no option in this event turns the ship hostile"
    }

                          },
                          "effects": [
                            {
                              "kind": "crew_loss",
                              "amount": 1,
                              "clone": true
                            }
                          ]
                        }
                      },
                      {
                        "share": null,
                        "child": {
                          "text": {
                            "value": "The cornered and frightened Mantis attacks as soon as you approach. You're able to subdue him and leave him at a Mantis colony in a neighboring system. They don't seem pleased or grateful at his return.",
                            "ref": "event_CONFUSED_MANTIS_DEFAULT_3_text"
                          },
                          "effects": []

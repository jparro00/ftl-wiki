{
  "schema": "ftl-event-tree/1",
  "id": "MERCHANT_DELIVER",
  "slug": "merchant-deliver",
  "title": "Merchant's delivery",
  "extracted_from": "raw/gamedata/events.xml",
  "text": {
    "value": "You arrive at the location given to you by the merchant. You are supposed to deliver drone parts to a station here.",
    "ref": "event_MERCHANT_DELIVER_text"
  },
  "name": "MERCHANT_DELIVER",
  "source": "raw/gamedata/events.xml",
  "effects": [],
  "node": {
    "kind": "decision",
    "options": [
      {
        "label": "Continue...",
        "gate": null,
        "child": {
          "effects": [],
          "node": {
            "kind": "chance",
            "list": "MERCHANT_DELIVER_LIST",
            "source": "raw/gamedata/events.xml",
            "odds_basis": "unweighted",
            "options": [
              {
                "share": null,
                "child": {
                  "text": {
                    "value": "You find the small research station and discover that it's putting out a distress signal. Strangely, there is no response to your hails.",
                    "ref": "event_MERCHANT_DELIVER_LIST_1_text"
                  },
                  "effects": [],
                  "node": {
                    "kind": "decision",
                    "options": [
                      {
                        "label": "Dock with the station and investigate.",
                        "gate": null,
                        "child": {
                          "effects": [],
                          "node": {
                            "kind": "chance",
                            "list": "STATION_SICK_LIST",
                            "source": "raw/gamedata/events.xml",
                            "odds_basis": "unweighted",
                            "options": [
                              {
                                "share": null,
                                "child": {
                                  "text": {
                                    "value": "Inside there are signs of a great struggle; scientists lie dead where they fell, brutally dismembered. You grab a few research drone parts lying on a desk near the door and leave quickly.",
                                    "ref": "event_STATION_SICK_LIST_1_text"
                                  },
                                  "effects": [
                                    {
                                      "kind": "reward",
                                      "level": "MED",
                                      "tier": "droneparts"
                                    }
                                  ]
                                }
                              },
                              {
                                "share": null,
                                "child": {
                                  "text": {
                                    "value": "You dock with the station and see a frantic person banging on the airlock door. Once inside your ship, he drops to the floor saying, \"My... friends... They've gone insane... They're coming!\" You hand him a blaster and turn to see a number of people charging toward the ship.",
                                    "ref": "event_STATION_SICK_LIST_2_text"
                                  },
                                  "effects": [
                                    {
                                      "kind": "crew_gain",
                                      "amount": 1
                                    }
                                  ],
                                  "node": {
                                    "kind": "decision",
                                    "options": [
                                      {
                                        "label": "Prepare for a fight!",
                                        "gate": null,
                                        "child": {
                                          "effects": [
                                            {
                                              "kind": "boarders",
                                              "min": 3,
                                              "max": 4,
                                              "class": "human"
                                            }
                                          ]
                                        },
                                        "label_ref": "event_STATION_SICK_LIST_2_c1_choice"
                                      },
                                      {
                                        "label": "(Medbay) Have the Advanced Medbay analyze their condition.",
                                        "gate": {
                                          "req": "medbay",
                                          "label": "Medbay",
                                          "lvl": "3",
                                          "max_group": "0"
                                        },
                                        "child": {
                                          "text": {
                                            "value": "You hold them off while retreating into the Med-bay. Its advanced systems determine that an alien neurotoxin is the cause of their frenzy. It synthesizes an antidote and releases it into the room. After a time, the scientists recover. One offers their services as thanks for saving them.",
                                            "ref": "event_STATION_SICK_LIST_2_c2_text"
                                          },
                                          "effects": [
                                            {
                                              "kind": "crew_gain",
                                              "amount": 1,
                                              "skills": {
                                                "repair": 1
                                              }
                                            },
                                            {
                                              "kind": "reward",
                                              "level": "MED",
                                              "tier": "scrap_only"
                                            }
                                          ]
                                        },
                                        "label_ref": "event_STATION_SICK_LIST_2_c2_choice",
                                        "hidden": true
                                      }
                                    ]
                                  }
                                }
                              },
                              {
                                "share": null,
                                "child": {
                                  "text": {
                                    "value": "As you explore the base, crazed screams are heard. Your team retreats back to your ship with a number of armed scientists in pursuit. One of your team starts to cough and falls in a spasm onto the floor.",
                                    "ref": "event_STATION_SICK_LIST_3_text"
                                  },
                                  "effects": [],
                                  "node": {
                                    "kind": "decision",
                                    "options": [
                                      {
                                        "label": "Drag him back to the ship and prepare for a fight.",
                                        "gate": null,
                                        "child": {
                                          "text": {
                                            "value": "As you get back on board, your injured friend rises up and starts to attack you, screaming. Caught off-guard, your remaining crew fall back as the other scientists fight their way onto the ship.",
                                            "ref": "event_STATION_SICK_LIST_3_c1_text"
                                          },
                                          "effects": [
                                            {
                                              "kind": "boarders",
                                              "min": 3,
                                              "max": 4,
                                              "class": "human"
                                            },
                                            {
                                              "kind": "crew_gain",
                                              "amount": -1,
                                              "class": "traitor"
                                            }
                                          ]
                                        },
                                        "label_ref": "event_STATION_SICK_LIST_3_c1_choice"
                                      },
                                      {
                                        "label": "(Teleporter) Use your Teleporter to retrieve your crew.",
                                        "gate": {
                                          "req": "teleporter",
                                          "label": "Crew Teleporter"
                                        },
                                        "child": {
                                          "text": {
                                            "value": "You beam your away team back to the ship and disengage from the station. Although the ship is safe, the infected crewmember quickly becomes frenzied and attacks.",
                                            "ref": "event_STATION_SICK_LIST_3_c2_text"
                                          },
                                          "effects": [
                                            {
                                              "kind": "crew_gain",
                                              "amount": -1,
                                              "class": "traitor"
                                            }
                                          ]
                                        },
                                        "label_ref": "event_STATION_SICK_LIST_3_c2_choice",
                                        "hidden": true
                                      },
                                      {
                                        "label": "(Medbay) Drag him back to the Medbay.",
                                        "gate": {
                                          "req": "medbay",
                                          "label": "Medbay",
                                          "lvl": "2",
                                          "max_group": "0"
                                        },
                                        "child": {
                                          "text": {
                                            "value": "You hold him down and the Medbay is able to stop whatever neurotoxin was on the ship from fully infecting your crew. Once he recovers, you prepare to fight off the scientists, who are beyond help.",
                                            "ref": "event_STATION_SICK_LIST_3_c3_text"
                                          },
                                          "effects": [
                                            {
                                              "kind": "boarders",
                                              "min": 3,
                                              "max": 4,
                                              "class": "human"
                                            }
                                          ]
                                        },
                                        "label_ref": "event_STATION_SICK_LIST_3_c3_choice",
                                        "hidden": true
                                      },
                                      {
                                        "label": "(Advanced Medbay) Have the Advanced Medbay analyze their condition.",
                                        "gate": {
                                          "req": "medbay",
                                          "label": "Medbay",
                                          "lvl": "3",
                                          "max_group": "0"
                                        },
                                        "child": {
                                          "text": {
                                            "value": "You hold them off while retreating into the Med-bay. Its advanced systems determine that an alien neurotoxin is driving your crewmember insane. It synthesizes an antidote and releases it into the ship. After a time, the frenzied scientists recover and one offers to help out as thanks for saving them.",
                                            "ref": "event_STATION_SICK_LIST_3_c4_text"
                                          },
                                          "effects": [
                                            {
                                              "kind": "crew_gain",
                                              "amount": 1
                                            }
                                          ]
                                        },
                                        "label_ref": "event_STATION_SICK_LIST_3_c4_choice",
                                        "hidden": true
                                      }
                                    ]
                                  }
                                }
                              }
                            ]
                          }
                        },
                        "label_ref": "event_MERCHANT_DELIVER_LIST_1_c1_choice",
                        "hidden": true
                      },
                      {
                        "label": "Leave it alone.",
                        "gate": null,
                        "child": {
                          "effects": []
                        },
                        "label_ref": "event_MERCHANT_DELIVER_LIST_1_c2_choice"
                      },
                      {
                        "label": "(Anti-Personnel Drone) Use an Anti-Personnel Drone to investigate.",
                        "gate": {
                          "req": "BATTLE",
                          "label": "Anti-Personnel Drone"
                        },
                        "child": {
                          "effects": [],
                          "node": {
                            "kind": "chance",
                            "list": "STATION_SICK_DRONE_LIST",
                            "source": "raw/gamedata/events.xml",
                            "odds_basis": "unweighted",
                            "options": [
                              {
                                "share": null,
                                "child": {
                                  "text": {
                                    "value": "You send your Anti-Personnel drone to explore the station. What you find is disconcerting... It appears that something has caused the scientists and guards to tear each other to pieces. You abandon the drone on the station for fear that it is contagious.",
                                    "ref": "event_STATION_SICK_DRONE_LIST_1_text"
                                  },
                                  "effects": [
                                    {
                                      "kind": "resource",
                                      "resource": "drones",
                                      "min": -1,
                                      "max": -1
                                    }
                                  ]
                                }
                              },
                              {
                                "share": null,
                                "child": {
                                  "text": {
                                    "value": "Once on board the station, your drone is immediately beset by frenzied scientists and guards. It eventually gets torn apart by the mob but it has bought you enough time to disengage from the station and escape into empty space.",
                                    "ref": "event_STATION_SICK_DRONE_LIST_2_text"
                                  },
                                  "effects": [
                                    {
                                      "kind": "resource",
                                      "resource": "drones",
                                      "min": -1,
                                      "max": -1
                                    }
                                  ]
                                }
                              },
                              {
                                "share": null,
                                "child": {
                                  "text": {
                                    "value": "The cameras mounted to your Anti-Personnel drone show a chaotic scene. No people are to be found but the remnants of a recent battle on-board the ship are obvious. You instruct the drone to retrieve some useful materials before leaving.",
                                    "ref": "event_STATION_SICK_DRONE_LIST_3_text"
                                  },
                                  "effects": [
                                    {
                                      "kind": "reward",
                                      "level": "MED",
                                      "tier": "standard"
                                    },
                                    {
                                      "kind": "resource",
                                      "resource": "drones",
                                      "min": -1,
                                      "max": -1
                                    }
                                  ]
                                }
                              }
                            ]
                          }
                        },
                        "label_ref": "event_MERCHANT_DELIVER_LIST_1_c3_choice",
                        "hidden": true
                      }
                    ]
                  }
                }
              },
              {
                "share": null,
                "child": {
                  "text": {
                    "value": "You find the station and they respond to your hails immediately, saying, \"It took you long enough! We have practically no use for these now... I refuse to pay full price, take this and leave the cargo in our holds.\"",
                    "ref": "event_MERCHANT_DELIVER_LIST_2_text"
                  },
                  "effects": [],
                  "node": {
                    "kind": "decision",
                    "options": [
                      {
                        "label": "Accept the paltry payment.",
                        "gate": null,
                        "child": {
                          "text": {
                            "value": "You drop the parts off and take your pay.",
                            "ref": "event_MERCHANT_DELIVER_LIST_2_c1_text"
                          },
                          "effects": [
                            {
                              "kind": "resource",
                              "resource": "scrap",
                              "min": 20,
                              "max": 30
                            },
                            {
                              "kind": "resource",
                              "resource": "drones",
                              "min": -5,
                              "max": -5
                            }
                          ]
                        },
                        "label_ref": "event_MERCHANT_DELIVER_LIST_2_c1_choice"
                      },
                      {
                        "label": "Refuse and keep the drone parts.",
                        "gate": null,
                        "child": {
                          "effects": [],
                          "node": {
                            "kind": "chance",
                            "list": "MERCHANT_DELIVER_BLUFF_LIST",
                            "dlc": true,
                            "source": "raw/gamedata/events.xml",
                            "odds_basis": "unweighted",
                            "options": [
                              {
                                "share": null,
                                "child": {
                                  "text": {
                                    "value": "\"Fine, I was bluffing. I'll pay the full price.\"",
                                    "ref": "event_MERCHANT_DELIVER_BLUFF_LIST_1_text"
                                  },
                                  "effects": [],
                                  "node": {
                                    "kind": "decision",
                                    "options": [
                                      {
                                        "label": "Accept the new offer.",
                                        "gate": null,
                                        "child": {
                                          "effects": [
                                            {
                                              "kind": "resource",
                                              "resource": "scrap",
                                              "min": 40,
                                              "max": 55
                                            },
                                            {
                                              "kind": "resource",
                                              "resource": "drones",
                                              "min": -5,
                                              "max": -5
                                            }
                                          ]
                                        },
                                        "label_ref": "event_MERCHANT_DELIVER_BLUFF_LIST_1_c1_choice"
                                      },
                                      {
                                        "label": "Leave.",
                                        "gate": null,
                                        "child": {
                                          "effects": []
                                        },
                                        "label_ref": "event_MERCHANT_DELIVER_BLUFF_LIST_1_c2_choice"
                                      }
                                    ]
                                  }
                                }
                              },
                              {
                                "share": null,
                                "child": {
                                  "text": {
                                    "value": "The merchant disconnects in a huff.",
                                    "ref": "event_MERCHANT_DELIVER_BLUFF_LIST_2_text"
                                  },
                                  "effects": []
                                }
                              }
                            ]
                          }
                        },
                        "label_ref": "event_MERCHANT_DELIVER_LIST_2_c2_choice",
                        "hidden": true
                      },
                      {
                        "label": "(Mind Control) Convince him that he's being 'unfair'.",
                        "gate": {
                          "req": "mind",
                          "label": "Mind Control"
                        },
                        "child": {
                          "text": {
                            "value": "\"I'm being unfair. You did the job and the parts are here safe and sound. Here is the agreed upon amount.\"",
                            "ref": "event_MERCHANT_DELIVER_LIST_2_c3_text"
                          },
                          "effects": [],
                          "node": {
                            "kind": "decision",
                            "options": [
                              {
                                "label": "Accept the new offer.",
                                "gate": null,
                                "child": {
                                  "effects": [
                                    {
                                      "kind": "resource",
                                      "resource": "scrap",
                                      "min": 40,
                                      "max": 55
                                    },
                                    {
                                      "kind": "resource",
                                      "resource": "drones",
                                      "min": -5,
                                      "max": -5
                                    }
                                  ]
                                },
                                "label_ref": "event_MERCHANT_DELIVER_LIST_2_c3_c1_choice"
                              },
                              {
                                "label": "Leave.",
                                "gate": null,
                                "child": {
                                  "effects": []
                                },
                                "label_ref": "event_MERCHANT_DELIVER_LIST_2_c3_c2_choice"
                              }
                            ]
                          }
                        },
                        "label_ref": "event_MERCHANT_DELIVER_LIST_2_c3_choice",
                        "hidden": true
                      },
                      {
                        "label": "(Weapons) Remain silent but power up your weapons.",
                        "gate": {
                          "req": "weapons",
                          "label": "Weapon Control",
                          "lvl": "6"
                        },
                        "child": {
                          "text": {
                            "value": "\"You make a good point. You traveled all the way out here to fulfill our request, despite what must have been... a difficult scenario to cause such a delay. Here, we'll even tip you for the inconvenience you must have gone through...\"",
                            "ref": "event_MERCHANT_DELIVER_LIST_2_c4_text"
                          },
                          "effects": [
                            {
                              "kind": "resource",
                              "resource": "scrap",
                              "min": 55,
                              "max": 70
                            },
                            {
                              "kind": "resource",
                              "resource": "drones",
                              "min": -5,
                              "max": -5
                            },
                            {
                              "kind": "resource",
                              "resource": "fuel",
                              "min": 2,
                              "max": 5
                            }
                          ]
                        },
                        "label_ref": "event_MERCHANT_DELIVER_LIST_2_c4_choice",
                        "hidden": true
                      }
                    ]
                  }
                }
              }
            ]
          }
        },
        "label_ref": "continue"
      }
    ]
  }
}

{
  "schema": "ftl-event-tree/1",
  "id": "LANIUS_DISTRESS_FIGHT",
  "slug": "lanius-ship-attacking-civilian-distress",
  "title": "Lanius ship attacking civilian distress",
  "extracted_from": "raw/gamedata/dlcEvents_anaerobic.xml",
  "text": {
    "value": "You immediately do a short-range scan after arriving at the beacon. It appears to be coming from a small civilian vessel under fire from a Lanius ship. Not all Lanius are content with simply scavenging the wrecks of previous battles.",
    "ref": "event_LANIUS_DISTRESS_FIGHT_text"
  },
  "name": "LANIUS_DISTRESS_FIGHT",
  "source": "raw/gamedata/dlcEvents_anaerobic.xml",
  "effects": [],
  "flags": {
    "unique": true,
    "beacon": "distress"
  },
  "node": {
    "kind": "decision",
    "options": [
      {
        "label": "Fight the Lanius ship.",
        "gate": null,
        "child": {
          "text": {
            "value": "You move in to intercept the ship. Detecting a greater threat, the Lanius prepare to fight.",
            "ref": "event_LANIUS_DISTRESS_FIGHT_c1_text"
          },
          "effects": [
            {
              "kind": "ship_hostility",
              "hostile": true
            }
          ]
        },
        "label_ref": "event_LANIUS_DISTRESS_FIGHT_c1_choice",
        "hidden": true
      },
      {
        "label": "Avoid the conflict.",
        "gate": null,
        "child": {
          "text": {
            "value": "Your crew seems unhappy to leave the civilians to such a fate but you try to convince them of the greater good. You don't speak of your own misgivings, however.",
            "ref": "event_LANIUS_DISTRESS_FIGHT_c2_text"
          },
          "effects": []
        },
        "label_ref": "event_LANIUS_DISTRESS_FIGHT_c2_choice",
        "hidden": true
      },
      {
        "label": "(Lanius Crew) Have your crew admonish their captain.",
        "gate": {
          "req": "anaerobic",
          "label": "Lanius"
        },
        "child": {
          "effects": [],
          "node": {
            "kind": "chance",
            "list": "LANIUS_DISTRESS_FIGHT_LANIUS",
            "source": "raw/gamedata/dlcEvents_anaerobic.xml",
            "odds_basis": "unweighted",
            "options": [
              {
                "share": null,
                "child": {
                  "text": {
                    "value": "After a discussion that your translator fails to comprehend, the enemy ship powers down its weapons. You learn that your crewmember sucessfully reminded them of their treatise promising to leave the property of sentient aliens alone. If this is a widespread rule of this race, there appear to be many who disagree with it. You attempt to hail the civilian ship now that it's safe.",
                    "ref": "event_LANIUS_DISTRESS_FIGHT_LANIUS_1_text"
                  },
                  "effects": [],
                  "node": {
                    "kind": "decision",
                    "options": [
                      {
                        "label": "Continue...",
                        "gate": null,
                        "child": {
                          "effects": [],
                          "node": {
                            "kind": "chance",
                            "list": "SAVE_CIVILIAN_LIST",
                            "source": "raw/gamedata/events_pirate.xml",
                            "odds_basis": "unweighted",
                            "options": [
                              {
                                "share": null,
                                "child": {
                                  "text": {
                                    "value": "The ship you saved was badly damaged in the battle. Most of the crew accepts your offer to be dropped off at a nearby station. One offers to join your crew.",
                                    "ref": "event_SAVE_CIVILIAN_LIST_1_text"
                                  },
                                  "effects": [],
                                  "node": {
                                    "kind": "decision",
                                    "options": [
                                      {
                                        "label": "Welcome aboard!",
                                        "gate": null,
                                        "child": {
                                          "text": {
                                            "value": "The survivor gets on board the ship.",
                                            "ref": "event_SAVE_CIVILIAN_LIST_1_c1_text"
                                          },
                                          "effects": [
                                            {
                                              "kind": "crew_gain",
                                              "amount": 1
                                            }
                                          ]
                                        },
                                        "label_ref": "event_SAVE_CIVILIAN_LIST_1_c1_choice"
                                      },
                                      {
                                        "label": "Decline their request.",
                                        "gate": null,
                                        "child": {
                                          "effects": []
                                        },
                                        "label_ref": "event_SAVE_CIVILIAN_LIST_1_c2_choice"
                                      }
                                    ]
                                  }
                                }
                              },
                              {
                                "share": null,
                                "child": {
                                  "text": {
                                    "value": "Apparently the ship that was being assaulted was a science vessel. They thank you for saving them and offer a small reward.",
                                    "ref": "event_SAVE_CIVILIAN_LIST_2_text"
                                  },
                                  "effects": [
                                    {
                                      "kind": "reward",
                                      "level": "MED",
                                      "tier": "standard"
                                    }
                                  ]
                                }
                              },
                              {
                                "share": null,
                                "child": {
                                  "text": {
                                    "value": "It seems the crew did not survive the assault. You take what you can from the remains of the ship.",
                                    "ref": "event_SAVE_CIVILIAN_LIST_3_text"
                                  },
                                  "effects": [
                                    {
                                      "kind": "reward",
                                      "level": "LOW",
                                      "tier": "standard"
                                    }
                                  ]
                                }
                              },
                              {
                                "share": null,
                                "child": {
                                  "text": {
                                    "value": "They respond, \"It's a good thing you came when you did; we'd be dead now otherwise. I'm a shipwright and I'd like to help you like you helped me.\"",
                                    "ref": "event_SAVE_CIVILIAN_LIST_4_text"
                                  },
                                  "effects": [],
                                  "node": {
                                    "kind": "decision",
                                    "options": [
                                      {
                                        "label": "The captain offers to install a piece of equipment on your ship.",
                                        "gate": null,
                                        "child": {
                                          "effects": [
                                            {
                                              "kind": "reward",
                                              "level": "LOW",
                                              "tier": "weapon"
                                            }
                                          ]
                                        },
                                        "label_ref": "event_SAVE_CIVILIAN_LIST_4_c1_choice"
                                      }
                                    ]
                                  }
                                }
                              },
                              {
                                "share": null,
                                "child": {
                                  "text": {
                                    "value": "\"This sector has become increasingly dangerous for friends of the Federation. I think my crew can patch up some of your hull damage as thanks.\"",
                                    "ref": "event_SAVE_CIVILIAN_LIST_5_text"
                                  },
                                  "effects": [
                                    {
                                      "kind": "hull_repair",
                                      "amount": 5
                                    }
                                  ]
                                }
                              },
                              {
                                "share": null,
                                "child": {
                                  "text": {
                                    "value": "The civilian ship wisely made a fast retreat while you distracted the hostile ship.",
                                    "ref": "event_SAVE_CIVILIAN_LIST_6_text"
                                  },
                                  "effects": []
                                }
                              }
                            ]
                          }
                        },
                        "label_ref": "continue",
                        "hidden": true
                      }
                    ]
                  }
                }
              },
              {
                "share": null,
                "child": {
                  "text": {
                    "value": "The ship refuses all hails, even from one of its own kind. It appears to have gone completely rogue. Before you can react, it begins to target your ship. Prepare for a fight.",
                    "ref": "event_LANIUS_DISTRESS_FIGHT_LANIUS_2_text"
                  },
                  "effects": [
                    {
                      "kind": "ship_hostility",
                      "hostile": true
                    }
                  ]
                }
              }
            ]
          }
        },
        "label_ref": "event_LANIUS_DISTRESS_FIGHT_c3_choice",
        "hidden": true
      }

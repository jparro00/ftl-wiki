{
  "schema": "ftl-event-tree/1",
  "id": "ZOLTAN_PEACE_QUEST",
  "slug": "unarmed-zoltan-transport",
  "title": "Unarmed Zoltan transport",
  "extracted_from": "raw/gamedata/events_zoltan.xml",
  "text": {
    "value": "An unarmed Zoltan transport vessel is slowly making its way toward the beacon here. They hail: \"This is a Zoltan peace envoy. We carry no weapons or shielding and rely on the mercy of others to communicate our message.\"",
    "ref": "event_ZOLTAN_PEACE_QUEST_text"
  },
  "name": "ZOLTAN_PEACE_QUEST",
  "source": "raw/gamedata/events_zoltan.xml",
  "effects": [],
  "flags": {
    "unique": true
  },
  "node": {
    "kind": "decision",
    "options": [
      {
        "label": "Attack them.",
        "gate": null,
        "child": {
          "effects": [],
          "node": {
            "kind": "chance",
            "list": "ZOLTAN_PEACE_QUEST_ATTACK",
            "source": "raw/gamedata/events_zoltan.xml",
            "odds_basis": "unweighted",
            "options": [
              {
                "share": null,
                "child": {
                  "text": {
                    "value": "You charge your weapons - not that this will take much.",
                    "ref": "event_ZOLTAN_PEACE_QUEST_ATTACK_1_text"
                  },
                  "effects": [],
                  "node": {
                    "kind": "combat",
                    "ship": "ZOLTAN_PEACE_QUEST_ATTACK1",
                    "ship_label": "Energy Fighter",
                    "hostile": true,
                    "auto_blueprint": "ZOLTAN_PEACE",
                    "source": "raw/gamedata/events_ships.xml",
                    "branches": [
                      {
                        "on": "destroyed",
                        "child": {
                          "text": {
                            "value": "You can't help but feel somewhat guilty as you search through the debris. It was probably a trap... right?",
                            "ref": "ship_ZOLTAN_PEACE_QUEST_ATTACK1_destroyed_text"
                          },
                          "effects": [
                            {
                              "kind": "reward",
                              "level": "LOW",
                              "tier": "standard"
                            }
                          ]
                        }
                      },
                      {
                        "on": "deadCrew",
                        "child": {
                          "text": {
                            "value": "You begin to strip their ship and don't find anything that would indicate they were on anything other than a peaceful mission. Perhaps you were too hasty.",
                            "ref": "ship_ZOLTAN_PEACE_QUEST_ATTACK1_deadCrew_text"
                          },
                          "effects": [
                            {
                              "kind": "reward",
                              "level": "RANDOM",
                              "tier": "standard"
                            }
                          ]
                        }
                      },
                      {
                        "on": "surrender",
                        "child": {
                          "text": {
                            "value": "They are clearly not putting up a fight. Are you sure you want to destroy them?",
                            "ref": "ship_ZOLTAN_PEACE_QUEST_ATTACK1_surrender_text"
                          },
                          "effects": [],
                          "node": {
                            "kind": "decision",
                            "options": [
                              {
                                "label": "Finish them off.",
                                "gate": null,
                                "child": {
                                  "text": {
                                    "value": "You continue the assault.",
                                    "ref": "ship_ZOLTAN_PEACE_QUEST_ATTACK1_surrender_c1_text"
                                  },
                                  "effects": []
                                },
                                "label_ref": "ship_ZOLTAN_PEACE_QUEST_ATTACK1_surrender_c1_choice",
                                "hidden": true
                              },
                              {
                                "label": "Let them go.",
                                "gate": null,
                                "child": {
                                  "text": {
                                    "value": "You power down your weapons and after a time the ship slowly limps away. They refuse all communications. You can't help but feel somewhat guilty.",
                                    "ref": "ship_ZOLTAN_PEACE_QUEST_ATTACK1_surrender_c2_text"
                                  },
                                  "effects": [
                                    {
                                      "kind": "ship_hostility",
                                      "hostile": false
                                    }
                                  ]
                                },
                                "label_ref": "ship_ZOLTAN_PEACE_QUEST_ATTACK1_surrender_c2_choice",
                                "hidden": true
                              }
                            ]
                          }
                        },
                        "chance": "0.2",
                        "min": "3",
                        "max": "4"
                      }
                    ]
                  }
                }
              },
              {
                "share": null,
                "child": {
                  "text": {
                    "value": "Just as you're preparing to attack you detect a nearby jump signature. A Zoltan defense ship comes to their aid!",
                    "ref": "event_ZOLTAN_PEACE_QUEST_ATTACK_2_text"
                  },
                  "effects": [],
                  "node": {
                    "kind": "combat",
                    "ship": "ZOLTAN_PEACE_QUEST_ATTACK2",
                    "ship_labels": [
                      "Energy Fighter",
                      "Energy Bomber"
                    ],
                    "hostile": true,
                    "auto_blueprint": "SHIPS_ZOLTAN",
                    "source": "raw/gamedata/events_ships.xml",
                    "branches": [
                      {
                        "on": "destroyed",
                        "child": {
                          "text": {
                            "value": "You defeat your assailant, but the peace ship has jumped away in the commotion.",
                            "ref": "ship_ZOLTAN_PEACE_QUEST_ATTACK2_destroyed_text"
                          },
                          "effects": [
                            {
                              "kind": "reward",
                              "level": "LOW",
                              "tier": "standard"
                            }
                          ]
                        }
                      },
                      {
                        "on": "deadCrew",
                        "child": {
                          "text": {
                            "value": "You defeat your assailant, but the peace ship has jumped away in the commotion.",
                            "ref": "ship_ZOLTAN_PEACE_QUEST_ATTACK2_destroyed_text"
                          },
                          "effects": [
                            {
                              "kind": "reward",
                              "level": "RANDOM",
                              "tier": "standard"
                            }
                          ]
                        }
                      }
                    ]
                  }
                }
              }
            ]

            "auto_blueprint": "SHIPS_ZOLTAN",
            "source": "raw/gamedata/events_rock.xml",
            "branches": [
              {
                "on": "destroyed",
                "child": {
                  "text": {
                    "value": "The Rock ship arrives just as you put the finishing blows to the Zoltan ship. They're not of a mind to thank you, and you get the impression it'd be best if you left post-haste...",

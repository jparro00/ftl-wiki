                      "kind": "reward",
                      "level": "LOW",
                      "tier": "standard"
                    }
                  ]
                }
              },
              {
                "on": "deadCrew",
                "child": {
                  "text": {
                    "value": "By the time the Rock ship arrives you've all but tied a bow around their quarry. The injured and dying Zoltan are easily taken into custody and the Rock ship grudgingly transfers over what you assume must be the bounty.",
                    "ref": "ship_ROCK_ZOLTAN_HELP_ZOLTAN_deadCrew_text"

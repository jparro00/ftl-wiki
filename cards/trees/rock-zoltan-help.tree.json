        "hidden": true
      },
      {
        "label": "Stay and capture the Zoltan.",
        "gate": null,
        "child": {
          "text": {
            "value": "This is Rock territory, and therefore Rock law - the Zoltan should have known better than to interfere. You'll have to disable their engines and piloting to ensure their safe capture.",

                            "req": "medbay",
                            "label": "Medbay",
                            "lvl": "2"
                          },
                          "child": {
                            "text": {
                              "value": "Your haste has paid off and you are able to bring him back from the brink of death. When his senses return he says, \"I never thought I would see this day, but... I am willing to devote myself and my ships to your cause.\"",
                              "ref": "event_MANTIS_NAMED_THIEF_DEFEAT_c2_c3_text"
                            },
                            "effects": [],
                            "node": {
                              "kind": "decision",
                              "options": [
                                {
                                  "label": "Accept.",
                                  "gate": null,
                                  "child": {

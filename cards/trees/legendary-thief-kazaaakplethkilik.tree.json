          },
          "effects": [
            {
              "kind": "ship_hostility",
              "hostile": true
            }
          ]
        },
        "label_ref": "event_MANTIS_NAMED_THIEF_c1_choice",
        "hidden": true
      },
      {
        "label": "Prepare to fight.",

{
  "schema": "ftl-event-tree/1",
  "id": "MANTIS_NAMED_THIEF",
  "slug": "legendary-thief-kazaaakplethkilik",
  "title": "Legendary thief KazaaakplethKilik",
  "extracted_from": "raw/gamedata/events_mantis.xml",
  "text": {
    "value": "You cross paths with a Mantis ship that looks to have had dozens of layers of armor-plating added over what must have been a hundred year career. Its captain is legendary thief KazaaakplethKilik. Your crew look frightened.",
    "ref": "event_MANTIS_NAMED_THIEF_text"
  },
  "name": "MANTIS_NAMED_THIEF",
  "source": "raw/gamedata/events_mantis.xml",
  "effects": [],
  "flags": {
    "unique": true
  },
  "node": {
    "kind": "decision",
    "options": [
      {
        "label": "(Mantis crewmember) Attempt to hail him.",
        "gate": {
          "req": "mantis",
          "label": "Mantis"
        },
        "child": {
          "text": {
            "value": "Your Mantis crew-member steps forward. He and KazaaakplethKilik perform a weird kind of alien haka. You, meanwhile, charge the battle systems.",

      }
    ],
    "combat": {
      "kind": "combat",
      "ship": "MANTIS_NAMED_THIEF",
      "ship_labels": [
        "Mantis Scout",
        "Mantis Fighter",
        "Mantis Bomber"
      ],
      "hostile": false,
      "auto_blueprint": "SHIPS_MANTIS",
      "source": "raw/gamedata/events_ships.xml",
      "branches": [
        {
          "on": "destroyed",
          "child": {
            "text": {
              "value": "KazaaakplethKilik fights to the last, and you pick the scraps from the corpse of his ship. You sense, though, that his death has left a great mystery unresolved.",
              "ref": "ship_MANTIS_NAMED_THIEF_destroyed_text"
            },
            "effects": [
              {
                "kind": "reward",
                "level": "MED",
                "tier": "standard"
              }
            ]
          }
        },
        {
          "on": "deadCrew",
          "child": {
            "text": {
              "value": "No more life signs are detected aboard their ship. You appear to have won.",
              "ref": "event_MANTIS_NAMED_THIEF_DEFEAT_text"
            },
            "name": "MANTIS_NAMED_THIEF_DEFEAT",
            "source": "raw/gamedata/events_mantis.xml",
            "effects": [],
            "node": {
              "kind": "decision",
              "options": [
                {
                  "label": "Move in to strip their ship.",
                  "gate": null,
                  "child": {
                    "text": {
                      "value": "It seems almost a waste for such a fierce foe to die in such an anticlimactic fashion. You shrug it off and take what you can.",
                      "ref": "event_MANTIS_NAMED_THIEF_DEFEAT_c1_text"
                    },
                    "effects": [
                      {
                        "kind": "reward",
                        "level": "HIGH",
                        "tier": "standard"
                      }
                    ]
                  },
                  "label_ref": "event_MANTIS_NAMED_THIEF_DEFEAT_c1_choice",
                  "hidden": true
                },
                {
                  "label": "(Teleporter) Quickly teleport additional crew and check for survivors.",
                  "gate": {
                    "req": "teleporter",
                    "label": "Crew Teleporter"
                  },
                  "child": {
                    "text": {
                      "value": "You find KazaaakplethKilik slumped in a corner dying.",
                      "ref": "event_MANTIS_NAMED_THIEF_DEFEAT_c2_text"
                    },
                    "effects": [],
                    "node": {
                      "kind": "decision",
                      "options": [
                        {
                          "label": "Put him out of his misery.",
                          "gate": null,
                          "child": {
                            "text": {
                              "value": "Thus ends the life of the famed captain, KazaaakplethKilik... You wonder what secrets went with him to the grave as you thoroughly loot his ship.",
                              "ref": "event_MANTIS_NAMED_THIEF_DEFEAT_c2_c1_text"
                            },
                            "effects": [
                              {
                                "kind": "reward",
                                "level": "HIGH",
                                "tier": "standard"
                              }
                            ]
                          },
                          "label_ref": "event_MANTIS_NAMED_THIEF_DEFEAT_c2_c1_choice",
                          "hidden": true
                        },
                        {
                          "label": "Listen to what he has to say.",
                          "gate": null,
                          "child": {
                            "text": {
                              "value": "In his dying moments he gives up the location of his secret stash. You strip the ship wondering what other secrets went with him to the grave.",
                              "ref": "event_MANTIS_NAMED_THIEF_DEFEAT_c2_c2_text"
                            },
                            "effects": [
                              {
                                "kind": "quest",
                                "event": "MANTIS_NAMED_THIEF_STASH"
                              },
                              {
                                "kind": "reward",
                                "level": "HIGH",
                                "tier": "standard"
                              }
                            ]
                          },
                          "label_ref": "event_MANTIS_NAMED_THIEF_DEFEAT_c2_c2_choice",
                          "hidden": true
                        },
                        {
                          "label": "(Adv. Medbay) Quickly teleport him back to the medbay.",

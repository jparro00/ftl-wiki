{
  "schema": "ftl-event-tree/1",
  "id": "QUEST_CONSTRUCTIONYARD",
  "slug": "space-station-under-construction",
  "title": "Space station under construction",
  "extracted_from": "raw/gamedata/newEvents.xml",
  "text": {
    "value": "You come across a space station under construction. You receive a message from their command tower, \"Greetings. We recently lost contact with a cargo ship that was set to deliver more construction materials. Could you help us figure out what happened to them?\"",
    "ref": "event_QUEST_CONSTRUCTIONYARD_text"
  },
  "name": "QUEST_CONSTRUCTIONYARD",
  "source": "raw/gamedata/newEvents.xml",
  "dlc": true,
  "effects": [],
  "flags": {
    "unique": true
  },
  "node": {
    "kind": "decision",
    "options": [
      {
        "label": "Offer your help.",
        "gate": null,
        "child": {
          "text": {
            "value": "\"Great. Thanks for your help. I've marked their last known coordinates and sent over some supplies to help you get there.\"",
            "ref": "event_QUEST_CONSTRUCTIONYARD_c1_text"
          },
          "effects": [
            {
              "kind": "resource",
              "resource": "missiles",
              "min": 0,
              "max": 4
            },
            {
              "kind": "resource",
              "resource": "drones",
              "min": 0,
              "max": 2
            },
            {
              "kind": "resource",
              "resource": "fuel",
              "min": 2,
              "max": 4
            },
            {
              "kind": "quest",
              "event": "QUEST_CONSTRUCTIONYARD_LIST"
            }
          ]
        },
        "label_ref": "event_QUEST_CONSTRUCTIONYARD_c1_choice",
        "hidden": true
      },
      {
        "label": "Decline.",
        "gate": null,
        "child": {
          "text": {
            "value": "\"I understand.\" Transmission has been cut.",
            "ref": "event_QUEST_CONSTRUCTIONYARD_c2_text"
          },
          "effects": []
        },
        "label_ref": "event_QUEST_CONSTRUCTIONYARD_c2_choice",
        "hidden": true
      },
      {
        "label": "(Lanius Crew) Offer to have your crewmember help.",
        "gate": {
          "req": "anaerobic",
          "label": "Lanius"
        },
        "child": {
          "text": {
            "value": "\"Interesting. So this metal man can help us make some of these unique parts out of scrap? That would be a huge help.\" Your crewmember checks over the blueprints and quickly converts some of their base metal sheets into the specialized parts.",
            "ref": "event_QUEST_CONSTRUCTIONYARD_c3_text"
          },
          "effects": [],
          "node": {
            "kind": "decision",
            "options": [
              {
                "label": "Continue...",
                "gate": null,
                "child": {
                  "text": {
                    "value": "\"Amazing! This robot thing could save us a ton of time. Could I buy it off you?\"",
                    "ref": "event_QUEST_CONSTRUCTIONYARD_c3_c1_text"
                  },
                  "effects": [],
                  "node": {
                    "kind": "decision",
                    "options": [
                      {
                        "label": "Ask your crew if they agree.",
                        "gate": null,
                        "child": {
                          "text": {
                            "value": "Once your Lanius crewmember understands the situation it appears to like the idea of assisting with construction in deep space. Much less dangerous. They offer you some goods in exchange.",
                            "ref": "event_QUEST_CONSTRUCTIONYARD_c3_c1_c1_text"
                          },
                          "effects": [
                            {
                              "kind": "reward",
                              "level": "HIGH",
                              "tier": "augment"
                            },
                            {
                              "kind": "crew_loss",
                              "amount": 1,
                              "clone": false,
                              "class": "anaerobic"
                            }
                          ]
                        },
                        "label_ref": "event_QUEST_CONSTRUCTIONYARD_c3_c1_c1_choice",
                        "hidden": true
                      },
                      {
                        "label": "Our crew is not for sale.",
                        "gate": null,
                        "child": {
                          "text": {
                            "value": "\"A pity. In terms of payment, here's some of the scrap metal we don't need now that we've got necessary parts.\"",
                            "ref": "event_QUEST_CONSTRUCTIONYARD_c3_c1_c2_text"
                          },
                          "effects": [
                            {
                              "kind": "reward",
                              "level": "MED",
                              "tier": "scrap_only"
                            }
                          ]
                        },
                        "label_ref": "event_QUEST_CONSTRUCTIONYARD_c3_c1_c2_choice",
                        "hidden": true
                      }
                    ]
                  }
                },
                "label_ref": "continue",
                "hidden": true
              }
            ]
          }
        },
        "label_ref": "event_QUEST_CONSTRUCTIONYARD_c3_choice",
        "hidden": true

                                      "amount": 1,
                                      "class": "human"
                                    }
                                  ]
                                }
                              }
                            ]
                          }
                        },
                        "label_ref": "event_STRANDED_2_c5_choice",
                        "hidden": true
                      }
                    ]
                  }
                }
              }
            ]

                              },
                              {
                                "share": null,
                                "child": {
                                  "text": {
                                    "value": "You bring the ship closer and the Slug, after a pause, says that the person is stable and with good intentions. You offer a position in your crew and it is graciously accepted.",
                                    "ref": "event_MADMAN_SLUG_2_text"
                                  },
                                  "effects": [
                                    {

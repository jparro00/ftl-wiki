                            "options": [
                              {
                                "share": null,
                                "child": {
                                  "text": {
                                    "value": "You bring the ship closer. The Slug enters a trance-like state for 1 to 2 seconds, then quickly snaps out of it. He states, \"This person is clearly unstable. It is best we leave them alone.\"",
                                    "ref": "event_MADMAN_SLUG_1_text"

                                  },
                                  "effects": [
                                    {
                                      "kind": "hull_damage",
                                      "amount": 4
                                    },
                                    {
                                      "kind": "system_damage",
                                      "amount": 1,
                                      "system": "random",
                                      "dlc": true
                                    }
                                  ]
                                }
                              },
                              {
                                "share": null,
                                "child": {
                                  "text": {
                                    "value": "It seems he was in worse health than we first thought. He collapses on the trip up to the ship. It doesn't look like he's going to make it...",
                                    "ref": "event_MADMAN_4_text"
                                  },
                                  "effects": [],
                                  "node": {
                                    "kind": "decision",
                                    "options": [
                                      {
                                        "label": "Continue...",
                                        "gate": null,
                                        "child": {
                                          "effects": []
                                        },
                                        "label_ref": "continue"
                                      },
                                      {
                                        "label": "(Improved Medbay) Quickly bring him to the medbay.",
                                        "gate": {
                                          "req": "medbay",
                                          "label": "Medbay",
                                          "lvl": "2"
                                        },
                                        "child": {
                                          "text": {
                                            "value": "Your improved medbay was able to resuscitate him. After a short time he recovers greatly saying, \"I really thought I was a goner... I haven't eaten for days. Would you mind if I stayed on your ship?\"",
                                            "ref": "event_MADMAN_4_c2_text"
                                          },
                                          "effects": [
                                            {
                                              "kind": "crew_gain",
                                              "amount": 1,
                                              "name": "Charlie"
                                            }
                                          ]
                                        },
                                        "label_ref": "event_MADMAN_4_c2_choice",
                                        "hidden": true
                                      },
                                      {
                                        "label": "(Improved Clonebay) Quickly register him into the clonebay.",
                                        "gate": {
                                          "req": "clonebay",
                                          "label": "Clone Bay",
                                          "lvl": "2"
                                        },
                                        "child": {
                                          "text": {
                                            "value": "Your quick reaction allowed your Clonebay to revive him after he passes. After he steps out of the machine he states, \"How am I alive? Wasn't I just dying on some shuttle? Technology sure has changed.\"",
                                            "ref": "event_MADMAN_4_c3_text"
                                          },
                                          "effects": [
                                            {
                                              "kind": "crew_gain",
                                              "amount": 1,
                                              "name": "Charlie"
                                            }
                                          ]
                                        },
                                        "label_ref": "event_MADMAN_4_c3_choice",
                                        "hidden": true,
                                        "dlc": true
                                      }
                                    ]
                                  }
                                }
                              }
                            ]
                          }
                        },
                        "label_ref": "event_STRANDED_2_c1_choice",
                        "hidden": true
                      },
                      {
                        "label": "Leave the madman to his ravings, he's not worth the risk.",
                        "gate": null,
                        "child": {
                          "effects": []
                        },
                        "label_ref": "event_STRANDED_2_c2_choice"
                      },
                      {
                        "label": "(Improved Medbay) Bring him to your medbay.",
                        "gate": {
                          "req": "medbay",
                          "label": "Medbay",
                          "lvl": "2",
                          "max_group": "0"
                        },
                        "child": {
                          "text": {
                            "value": "Once inside your medbay, the system is able to restore his body and undo some of the damage to his brain. Once awake he states, \"I feel almost like my old self again... Thank you. Please let me serve on your ship.\"",
                            "ref": "event_STRANDED_2_c3_text"
                          },
                          "effects": [
                            {
                              "kind": "crew_gain",
                              "amount": 1,
                              "name": "Charlie"
                            }
                          ]
                        },
                        "label_ref": "event_STRANDED_2_c3_choice",
                        "hidden": true
                      },
                      {
                        "label": "(Advanced Medbay) Bring him to your medbay.",
                        "gate": {
                          "req": "medbay",
                          "label": "Medbay",
                          "lvl": "3",
                          "max_group": "0"
                        },
                        "child": {
                          "text": {
                            "value": "Once inside your advanced medbay, the system is able to identify and minimize the trauma associated with being alone for so long. Once awake he states, \"I don't know how to repay you, I feel 10 years younger... Let me serve on your ship.\"",
                            "ref": "event_STRANDED_2_c4_text"
                          },
                          "effects": [
                            {
                              "kind": "crew_gain",
                              "amount": 1,
                              "all_skills": 1,
                              "name": "Charlie"
                            }
                          ]
                        },
                        "label_ref": "event_STRANDED_2_c4_choice",
                        "hidden": true,
                        "dlc": true
                      },
                      {
                        "label": "(Slug Crew) \"Sir, allow me to assess his mental state.\"",

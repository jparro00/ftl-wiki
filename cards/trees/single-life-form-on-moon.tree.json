                            "options": [
                              {
                                "share": null,
                                "child": {
                                  "text": {
                                    "value": "The family apparently owns one of the most valuable mining enterprises in the sector. For the safe return of his son, the patron of the family offers you a substantial reward.",
                                    "ref": "event_FAMILY_RETURN_1_text"

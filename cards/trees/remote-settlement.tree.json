        },
        "child": {
          "text": {
            "value": "The pirate watches as you teleport an incendiary explosive into the settlement. As the settlers scramble to put out the fires, their rudimentary planetary defenses power down. Forcing their surrender was laughably easy, but the pirate seems impressed with your tactics and agrees to share the settlement's 'tribute'.",
            "ref": "event_PIRATE_STATION_CROPS_c4_text"
          },
          "effects": [
            {
              "kind": "resource",
              "resource": "missiles",
              "min": -1,

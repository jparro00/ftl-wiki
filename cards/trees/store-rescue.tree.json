  "source": "raw/gamedata/events.xml",
  "effects": [],
  "flags": {
    "unique": true
  },
  "node": {
    "kind": "decision",
    "options": [
      {
        "label": "See if you can assist them.",
        "gate": null,
        "child": {
          "text": {
            "value": "It seems that a small space dock has done something to anger the Rebels. The store there is run by his family and he pleads that you rescue them. He uploads the coordinates of the station to your navigation system.",
            "ref": "event_STORE_RESCUE_c1_text"
          },
          "effects": [
            {
              "kind": "quest",
              "event": "QUEST_STORE_RESCUE"
            }
          ]
        },
        "label_ref": "event_STORE_RESCUE_c1_choice"
      },
      {
        "label": "Ignore their pleas.",
        "gate": null,
        "child": {
          "text": {
            "value": "You block the channel and prepare to jump as soon as possible.",
            "ref": "event_STORE_RESCUE_c2_text"
          },
          "effects": []
        },
        "label_ref": "event_STORE_RESCUE_c2_choice"
      }
    ]
  },

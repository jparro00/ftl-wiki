  "extracted_from": "raw/gamedata/events.xml",
  "text": {
    "value": "Once you arrive at this populated region, you immediately pick up a distress signal. A small shuttle is asking anyone who'll listen for help protecting their family from a Rebel ship. Unsurprisingly, no one has yet responded to their request.",
    "ref": "event_STORE_RESCUE_text"
  },

            "kind": "decision",
            "options": [
              {
                "label": "Stop the fight.",
                "gate": null,
                "child": {
                  "text": {
                    "value": "They accept your explanation and allow you to approach the fleet. It appears they are miners and colonists from a fringe settlement who are fleeing to more protected space after hearing reports of pirate and Rebel attacks.",

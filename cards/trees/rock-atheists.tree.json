    "options": [
      {
        "label": "Tell them their god sent them here to join your crew.",
        "gate": null,
        "child": {
          "text": {
            "value": "They barely hear out your appeals before yelling, \"These are the lies I sought to escape!\" Looks like they're charging weapons!",
            "ref": "ROCK_ATHIEST_BAD",
            "variants": 2
          },
          "effects": [
            {
              "kind": "ship_hostility",
              "hostile": true
            }
          ]
        },
        "label_ref": "event_ROCK_ATHIEST_c1_choice",
        "hidden": true
      },
      {
        "label": "Promise to share with them the truths they've been denied.",

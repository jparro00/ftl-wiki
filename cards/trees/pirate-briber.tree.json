{
  "schema": "ftl-event-tree/1",
  "id": "PIRATE_BRIBER",
  "slug": "pirate-briber",
  "title": "Pirate briber",
  "extracted_from": "raw/gamedata/events_pirate.xml",
  "text": {
    "value": "You come across a pirate in hot pursuit of an unidentified ship. You quickly receive a transmission from the pirate: \"Stay out of this fight and we'll make it worth your while.\"",
    "ref": "PIRATE_BRIBER",
    "variants": 3
  },
  "name": "PIRATE_BRIBER",
  "source": "raw/gamedata/events_pirate.xml",
  "effects": [],
  "flags": {
    "unique": true
  },
  "node": {
    "kind": "decision",
    "options": [
      {
        "label": "Accept their bribe.",
        "gate": null,
        "child": {
          "text": {
            "value": "\"Good choice, son. We've both come out of this richer.\"",
            "ref": "event_PIRATE_BRIBER_c1_text"
          },
          "effects": [
            {
              "kind": "reward",
              "level": "LOW",
              "tier": "standard"
            }
          ]
        },
        "label_ref": "event_PIRATE_BRIBER_c1_choice"
      },
      {
        "label": "Try to be a hero. Attack the pirate.",
        "gate": null,
        "child": {
          "text": {
            "value": "The pirate ship stops its pursuit and locks weapons onto your ship.",
            "ref": "event_PIRATE_BRIBER_c2_text"
          },
          "effects": [
            {
              "kind": "ship_hostility",
              "hostile": true
            }
          ]
        },
        "label_ref": "event_PIRATE_BRIBER_c2_choice"
      }
    ],
    "combat": {

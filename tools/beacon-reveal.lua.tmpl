-- beacon-reveal -- names every beacon on the sector map, revealed or not.
--
-- GENERATED by tools/build-beacon-mod.py from cards/trees/*.tree.json and
-- sectors/data/*.sector.json. Edit this template, never the generated file.
--
-- Why this works: FTL picks each beacon's event when it generates the sector, so
-- Location.event is populated long before the player jumps there. The engine simply
-- declines to draw it. Reading it back is a reveal, not a computation.
--
-- What is shown:
--   on the map   the beacon's CATEGORY -- the sector event pool it was rolled from
--                (DISTRESS_BEACON_ENGI, STORE, HOSTILE1 ...), in a box styled like
--                the game's own STORE / EXIT labels
--   on hover     the concrete event's name, written into the game's own tooltip in
--                place of "An unvisited location."

local NAMES = {
--%%NAMES%%
}

-- Display sector name -> { event id -> the pool that event was rolled from }.
-- Scoped per sector because pool membership overlaps between sectors far more than
-- within one: NEUTRAL_ENGI and NEUTRAL_MANTIS share events, but no Engi sector rolls
-- from NEUTRAL_MANTIS.
local BY_SECTOR = {
--%%BY_SECTOR%%
}

-- event id -> pool, for events whose pool is the same in every sector that has them.
-- Used when the sector name cannot be read, or the event is not in that sector's pools.
local ANY_SECTOR = {
--%%ANY_SECTOR%%
}

-- pool -> section, only to colour the box the way the game colours its own labels.
local SECTION = {
--%%SECTION%%
}

local FONT = %%FONT%%
local RISE = %%RISE%%       -- label box sits this far above the beacon

-- Where beacon coordinate 0,0 lands on screen. Measured, not documented -- see
-- tools/BEACON-REVEAL.md section 3.2. Preferred from starMap.position when a future
-- Hyperspace exposes it.
local FALLBACK_X = %%ORIGIN_X%%
local FALLBACK_Y = %%ORIGIN_Y%%

-- Box geometry. GLYPH_H is only a fallback: the real line height is measured from the
-- font itself on first use, because guessing it is what made the first version's text
-- overflow its box.
local GLYPH_H, PAD_X, PAD_Y = %%GLYPH_H%%, 5, 3
local glyph_h = nil

local reported = {}
local index_base = nil

local function report(key, msg)
    if not reported[key] then
        reported[key] = true
        log("beacon-reveal: " .. tostring(msg))
    end
end

-- Namespaces differ between Hyperspace versions; resolve once and fail loudly.
local CS = Graphics.CSurface or Hyperspace.CSurface
local Colour = Graphics.GL_Color or Hyperspace.GL_Color

local STYLES = {
    store    = {edge = {0.36, 0.90, 0.55}},
    distress = {edge = {1.00, 0.78, 0.24}},
    hostile  = {edge = {0.95, 0.42, 0.38}},
    exit     = {edge = {0.36, 0.90, 0.55}},
    nebula   = {edge = {0.78, 0.55, 0.95}},
    quest    = {edge = {0.55, 0.80, 1.00}},
}
local DEFAULT_EDGE = {0.72, 0.86, 0.92}
local UNKNOWN_EDGE = {0.55, 0.58, 0.60}   -- no category known: dim, so it reads as "unlabelled"

local function edge_for(pool)
    if pool == nil then return UNKNOWN_EDGE end
    local style = STYLES[SECTION[pool] or ""]
    return style and style.edge or DEFAULT_EDGE
end

-- The font's own line height, asked for once rather than assumed. Logged, so the
-- number the boxes are built from is answerable from FTL_HS.log.
local function line_height()
    if glyph_h ~= nil then return glyph_h end
    glyph_h = GLYPH_H
    local ok, a, b = pcall(function()
        return Graphics.freetype.easy_measurePrintLines(FONT, 0, 0, 9999, "Ay")
    end)
    if ok then
        local h
        if type(a) == "number" and type(b) == "number" then h = b
        elseif type(a) == "number" then h = a
        elseif a ~= nil then
            pcall(function() h = a.y end)
        end
        report("measure", "easy_measurePrintLines(font " .. FONT .. ") -> "
               .. tostring(a) .. ", " .. tostring(b) .. "  height=" .. tostring(h))
        if type(h) == "number" and h > 2 and h < 40 then glyph_h = h end
    else
        report("measure", "easy_measurePrintLines unavailable, box height falls back to "
               .. GLYPH_H)
    end
    return glyph_h
end

-- A box with text in it, centred on x, vertically centred on y.
--
-- easy_printCenter's y is the **top** of the line box, not its centre. That was
-- recorded the wrong way round at first, and it did not show while the origin was
-- being calibrated -- the half-line error was simply absorbed into ORIGIN_Y. It only
-- became visible once the font changed and the text sat low, hanging out of the box.
-- Lifting the text by half the line height puts it back in the middle.
local function draw_box(x, y, text, edge)
    local w = Graphics.freetype.easy_measureWidth(FONT, text)
    local h = line_height()
    local x1 = x - w / 2 - PAD_X
    local y1 = y - h / 2 - PAD_Y
    local bw = w + PAD_X * 2
    local bh = h + PAD_Y * 2
    CS.GL_DrawRect(x1, y1, bw, bh, Colour(0, 0, 0, 0.72))
    CS.GL_DrawRectOutline(x1, y1, bw, bh, Colour(edge[1], edge[2], edge[3], 0.95), 1)
    Graphics.freetype.easy_printCenter(FONT, x, y - math.floor(h / 2), text)
end

local function detect_base(locations)
    if index_base ~= nil then return index_base end
    index_base = pcall(function() return locations[0] end) and 0 or 1
    report("base", "vector index base = " .. index_base)
    return index_base
end

local function origin_of(starMap)
    local ok, pos = pcall(function() return starMap.position end)
    if ok and pos ~= nil and pos.x ~= nil then
        report("origin", "origin from starMap.position = " .. pos.x .. "," .. pos.y)
        return pos.x, pos.y
    end
    report("origin", "starMap.position unavailable, using measured origin "
                     .. FALLBACK_X .. "," .. FALLBACK_Y)
    return FALLBACK_X, FALLBACK_Y
end

local function sector_table(starMap)
    local ok, name = pcall(function()
        return starMap.currentSector.description.name:GetText()
    end)
    if not ok or name == nil or name == "" then
        report("sector", "sector name unreadable, categories fall back to ANY_SECTOR")
        return nil
    end
    local t = BY_SECTOR[name]
    if t == nil then
        report("sector:" .. name, "no pool table for sector " .. name)
    end
    return t
end

local function event_id(loc)
    local ok, name = pcall(function() return loc.event.eventName end)
    if not ok or name == nil or name == "" then return nil end
    return name
end

-- The open star map, or nil. Everything both passes need, resolved once per call.
local function open_map()
    local starMap = Hyperspace.Global.GetInstance():GetCApp().world.starMap
    if not starMap.bOpen then return nil end
    local locations = starMap.locations
    local count = locations:size()
    if count == nil or count == 0 then return nil end
    local base = detect_base(locations)
    local ox, oy = origin_of(starMap)
    return starMap, locations, base, base + count - 1, ox, oy, count
end

-- Pass 1: the category box on every beacon. Drawn under the cursor and tooltip.
local function draw_categories()
    local starMap, locations, base, last, ox, oy, count = open_map()
    if starMap == nil then return end
    local scoped = sector_table(starMap)

    local named, unvisited_named, sample = 0, 0, {}
    for i = base, last do
        local loc = locations[i]
        if loc ~= nil then
            local id = event_id(loc)
            if id ~= nil then
                local pool = (scoped and scoped[id]) or ANY_SECTOR[id]
                draw_box(loc.loc.x + ox, loc.loc.y + oy - RISE, pool or id, edge_for(pool))
                named = named + 1
                if loc.visited == 0 then
                    unvisited_named = unvisited_named + 1
                    if #sample < 4 then
                        sample[#sample + 1] = (pool or id) .. "=" .. (NAMES[id] or id)
                    end
                end
            end
        end
    end

    local key = "sector:" .. tostring(starMap.worldLevel) .. ":" .. tostring(count)
    report(key, "sector " .. tostring(starMap.worldLevel + 1) .. ": named " .. named
           .. " beacons, " .. unvisited_named .. " unvisited -- "
           .. table.concat(sample, " / "))
end

-- Pass 2: the hovered beacon's event name, put into the game's **own** tooltip -- the
-- box that otherwise says "An unvisited location." -- rather than drawn as a second
-- box of ours.
--
-- Hyperspace's StarMap::MouseMove sets that text with
-- `GetMouseControl()->SetTooltip(GetLocationText(hoverLoc))` during the game loop.
-- MOUSE_CONTROL's before-callback runs after the loop and before MouseControl::OnRender
-- draws the tooltip, so overwriting it here is the last word for that frame, and the
-- game renders our string in its own box with its own styling and placement.
local function apply_hover_tooltip()
    local starMap, locations, base, last = open_map()
    if starMap == nil then return end

    local hovered = starMap.hoverLoc
    if hovered == nil then return end

    -- Matched on coordinates, not object identity: SWIG does not promise the same
    -- wrapper object for the same underlying pointer.
    local hx, hy
    pcall(function() hx, hy = hovered.loc.x, hovered.loc.y end)
    if hx == nil then return end

    for i = base, last do
        local loc = locations[i]
        if loc ~= nil and loc.loc.x == hx and loc.loc.y == hy then
            local id = event_id(loc)
            if id ~= nil then
                local text = NAMES[id] or id
                -- Only on change: SetTooltip resets the tooltip's timer, and doing
                -- that every frame would keep restarting its fade.
                if Hyperspace.Mouse.tooltip ~= text then
                    Hyperspace.Mouse:SetTooltip(text)
                    Hyperspace.Mouse:InstantTooltip()
                end
            end
            return
        end
    end
end

-- There is no star-map render layer in Defines.RenderEvents. MOUSE_CONTROL renders on
-- every screen, so it fires over the map; bOpen is what keeps the labels off the rest.
script.on_render_event(
    Defines.RenderEvents.MOUSE_CONTROL,
    function()
        local ok, err = pcall(draw_categories)
        if not ok then report("draw", err) end
        ok, err = pcall(apply_hover_tooltip)
        if not ok then report("hover", err) end
    end,
    function() end)

log("beacon-reveal: loaded, %%COUNT%% names, %%POOLS%% categories")
